# Database connection mode: "tcp" for local dev (Cloud SQL Auth Proxy), "socket" for Cloud Run
DB_CONNECTION_MODE=tcp

# Cloud SQL instance connection name (used in socket mode)
CLOUD_SQL_INSTANCE_CONNECTION_NAME=project:region:instance

# TCP connection settings (used in tcp mode / local dev with Cloud SQL Auth Proxy)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=interviewprep-ai-database
DB_USER=postgres
DB_PASSWORD=

# GCP Secret Manager (set to "true" to pull DB credentials from Secret Manager)
USE_SECRET_MANAGER=false
GCP_PROJECT_ID=

# Secret names in Secret Manager (only used when USE_SECRET_MANAGER=true)
SECRET_DB_USER=db-user
SECRET_DB_PASSWORD=db-password

# CORS: comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Embedding model for semantic search
EMBEDDING_MODEL=all-MiniLM-L6-v2
